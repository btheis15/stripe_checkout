# Server-only (never prefix these with NEXT_PUBLIC_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres (Supabase, Neon, Vercel Postgres, RDS…). With Supabase's pooler on port 6543, keep prepare: false in lib/db.ts.
DATABASE_URL=

# Your site's public address (Vercel previews: set per environment).
SITE_URL=http://localhost:3000

# "true" once Stripe → Tax is set up.
STRIPE_TAX=false
