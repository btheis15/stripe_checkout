# Stripe → Developers → API keys → Secret key. sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=

# The webhook signing secret (whsec_…):
#  - locally: printed by `stripe listen --forward-to localhost:4242/webhooks/stripe`
#  - deployed: Stripe → Developers → Webhooks → your endpoint → Signing secret
# Test and live endpoints each have their own.
STRIPE_WEBHOOK_SECRET=

# Where shoppers come back to after paying (no trailing slash).
SITE_URL=http://localhost:4242

# Optional: protects POST /admin/orders/:id/refund (send as "Authorization: Bearer <token>").
ADMIN_TOKEN=

# Optional: "true" to have Stripe Tax add sales tax (set up Stripe → Tax first).
STRIPE_TAX=false

PORT=4242
